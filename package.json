{
  "name": "hadekost",
  "version": "1.0.0",
  "description": "Aplikasi manajemen kost: kamar, penyewa, tagihan, pembayaran, ledger operasional, laporan.",
  "main": "index.js",
  "scripts": {
    "test": "bash tools/uji-lokal.sh",
    "dev": "wrangler dev --local --var COOKIE_SECURE:false --port 8787",
    "deploy": "npm run ui && wrangler deploy",
    "db:init": "wrangler d1 execute hadekost-db --local --file=db/schema.sql",
    "db:init:remote": "wrangler d1 execute hadekost-db --remote --file=db/schema.sql",
    "uji": "bash tools/uji-lokal.sh",
    "backup": "bash tools/backup-produksi.sh manual",
    "ui": "tailwindcss -c tailwind.config.cjs -i pub/tailwind.src.css -o pub/tailwind.css --minify"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kosthadepurwokerto/app.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/kosthadepurwokerto/app/issues"
  },
  "homepage": "https://github.com/kosthadepurwokerto/app#readme",
  "private": "true",
  "type": "module",
  "devDependencies": {
    "tailwindcss": "^3.4.19",
    "wrangler": "^4.151.3"
  }
}
